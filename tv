def _prompt(label: str, current: str = "") -> str:
    hint = f" [{current[:6]}…]" if current else ""
    try:
        value = input(f"  {label}{hint}: ").strip()
    except EOFError:
        return current
    return value or current


def cmd_connect(args) -> int:
    """Interactive walkthrough for a floating terminal: creds + device login."""
    platform = args.platform
    creds = load_json(CRED_FILE, {})

    if platform == "twitch":
        print("\nConnect Twitch\n" + "=" * 40)
        # Twitch works out of the box with the bundled Client ID; only prompt
        # when the user explicitly wants their own app (`--force`).
        if args.force:
            print(TWITCH_STEPS)
            cid = _prompt("Twitch Client ID", creds.get("twitch_client_id", ""))
            if cid:
                creds["twitch_client_id"] = cid
                save_json(CRED_FILE, creds)
        print("\nOpening Twitch for device authorization…")
        return cmd_auth_twitch(args)

    print("\nConnect YouTube\n" + "=" * 40)
    if not (creds.get("youtube_client_id") and creds.get("youtube_client_secret")) or args.force:
        print(YOUTUBE_STEPS)
        cid = _prompt("YouTube Client ID", creds.get("youtube_client_id", ""))
        secret = _prompt("YouTube Client secret", creds.get("youtube_client_secret", ""))
        if not (cid and secret):
            print("\nNeed both a Client ID and secret — nothing saved.")
            return 1
        creds["youtube_client_id"] = cid
        creds["youtube_client_secret"] = secret
        save_json(CRED_FILE, creds)
    print("\nOpening Google for device authorization…")
    return cmd_auth_youtube(args)


