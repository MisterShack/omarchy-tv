def youtube_subscriptions(force: bool = False) -> list[dict]:
    cache = load_json(SUBS_CACHE, None)
    if cache and not force and now() - cache.get("fetched_at", 0) < SUBS_CACHE_TTL:
        return cache["items"]

    access = youtube_access_token()
    headers = {"Authorization": f"Bearer {access}"}
    items, token = [], None
    for _ in range(40):
        url = (
            "https://www.googleapis.com/youtube/v3/subscriptions"
            "?part=snippet&mine=true&maxResults=50&order=alphabetical"
        )
        if token:
            url += f"&pageToken={token}"
        page = http("GET", url, headers=headers)
        for it in page.get("items", []):
            sn = it.get("snippet", {})
            cid = (sn.get("resourceId") or {}).get("channelId")
            if cid:
                items.append({"channel_id": cid, "title": sn.get("title", "")})
        token = page.get("nextPageToken")
        if not token:
            break
    save_json(SUBS_CACHE, {"fetched_at": now(), "items": items})
    return items


def _recent_video_ids(channel_id: str) -> list[str]:
    """Channel RSS feed -> most recent video ids. Free, no API quota."""
    try:
        xml = fetch_text(
            f"https://www.youtube.com/feeds/videos.xml?channel_id={channel_id}"
        )
        root = ET.fromstring(xml)
    except (OSError, ET.ParseError, urllib.error.URLError):
        return []
    ns = {"yt": "http://www.youtube.com/xml/schemas/2015"}
    ids = [e.text for e in root.iterfind(".//yt:videoId", ns) if e.text]
    return ids[:4]


def youtube_live() -> list[dict]:
    subs = youtube_subscriptions()
    if not subs:
        return []

    with ThreadPoolExecutor(max_workers=16) as pool:
        id_lists = list(pool.map(lambda s: _recent_video_ids(s["channel_id"]), subs))
    candidate_ids = [vid for sub in id_lists for vid in sub]
    if not candidate_ids:
        return []

    access = youtube_access_token()
    headers = {"Authorization": f"Bearer {access}"}
    live = []
    for i in range(0, len(candidate_ids), 50):
        chunk = candidate_ids[i : i + 50]
        page = http(
            "GET",
            "https://www.googleapis.com/youtube/v3/videos"
            "?part=snippet,liveStreamingDetails&id=" + ",".join(chunk),
            headers=headers,
        )
        for v in page.get("items", []):
            sn = v.get("snippet", {})
            if sn.get("liveBroadcastContent") != "live":
                continue
            details = v.get("liveStreamingDetails", {})
            thumbs = sn.get("thumbnails", {})
            thumb = (
                thumbs.get("medium") or thumbs.get("high") or thumbs.get("default") or {}
            ).get("url", "")
            live.append(
                {
                    "platform": "youtube",
                    "id": v.get("id", ""),
                    "fav_id": sn.get("channelId", ""),
                    "channel": sn.get("channelTitle", ""),
                    "login": sn.get("channelId", ""),
                    "title": (sn.get("title") or "").strip(),
                    "category": "",
                    "viewers": int(details.get("concurrentViewers", 0) or 0),
                    "thumbnail": thumb,
                    "started_at": details.get("actualStartTime", ""),
                    "url": f"https://www.youtube.com/watch?v={v.get('id', '')}",
                    "live": True,
                }
            )
    return live


def youtube_search(query: str) -> list[dict]:
    access = youtube_access_token()
    headers = {"Authorization": f"Bearer {access}"}
    page = http(
        "GET",
        "https://www.googleapis.com/youtube/v3/search"
        "?part=snippet&type=channel&maxResults=15&q=" + urllib.parse.quote(query),
        headers=headers,
    )
    results = []
    for it in page.get("items", []):
        sn = it.get("snippet", {})
        cid = (it.get("id") or {}).get("channelId", "")
        thumbs = sn.get("thumbnails", {})
        thumb = (thumbs.get("medium") or thumbs.get("default") or {}).get("url", "")
        results.append(
            {
                "platform": "youtube",
                "id": cid,
                "fav_id": cid,
                "channel": sn.get("channelTitle") or sn.get("title", ""),
                "login": cid,
                "title": (sn.get("description") or "").strip(),
                "category": "",
                "viewers": 0,
                "thumbnail": thumb,
                "started_at": "",
                "url": f"https://www.youtube.com/channel/{cid}",
                "live": False,
            }
        )
    return results


