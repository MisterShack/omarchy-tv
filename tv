def _ensure_dirs() -> None:
    os.makedirs(CRED_DIR, exist_ok=True)
    os.makedirs(STATE_DIR, exist_ok=True)


def load_json(path: str, default):
    try:
        with open(path, "r", encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return default


def save_json(path: str, data) -> None:
    _ensure_dirs()
    tmp = f"{path}.tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(data, fh, indent=2)
    os.replace(tmp, path)
    try:
        os.chmod(path, 0o600)
    except OSError:
        pass


class TvError(RuntimeError):
    pass


def http(method: str, url: str, *, headers=None, data=None, form=None, timeout=15):
    """Return parsed JSON (or raw text for non-JSON). Raises TvError on HTTP >= 400."""
    body = None
    hdrs = {"User-Agent": USER_AGENT, "Accept": "application/json"}
    if headers:
        hdrs.update(headers)
    if form is not None:
        body = urllib.parse.urlencode(form).encode()
        hdrs["Content-Type"] = "application/x-www-form-urlencoded"
    elif data is not None:
        body = json.dumps(data).encode()
        hdrs["Content-Type"] = "application/json"

    req = urllib.request.Request(url, data=body, headers=hdrs, method=method)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            raw = resp.read().decode("utf-8", "replace")
    except urllib.error.HTTPError as exc:
        detail = exc.read().decode("utf-8", "replace")
        try:
            parsed = json.loads(detail)
        except ValueError:
            parsed = {"raw": detail}
        raise TvError(f"{method} {url} -> HTTP {exc.code}: {parsed}") from None
    except urllib.error.URLError as exc:
        raise TvError(f"{method} {url} -> {exc.reason}") from None

    if not raw:
        return {}
    try:
        return json.loads(raw)
    except ValueError:
        return raw


def fetch_text(url: str, timeout=8) -> str:
    req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        return resp.read().decode("utf-8", "replace")


def now() -> int:
    return int(time.time())


def out(obj, as_json: bool) -> None:
    if as_json:
        print(json.dumps(obj))
    else:
        _print_human(obj)


