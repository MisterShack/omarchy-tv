def _twitch_thumb(url: str, w=440, h=248) -> str:
    return (url or "").replace("{width}", str(w)).replace("{height}", str(h))


def twitch_live() -> list[dict]:
    access, client_id, user_id = twitch_access_token()
    if not user_id:
        raise TvError("Twitch token has no user id; re-run `tv auth twitch`")
    headers = {"Authorization": f"Bearer {access}", "Client-Id": client_id}
    streams, cursor = [], None
    for _ in range(10):
        url = f"https://api.twitch.tv/helix/streams/followed?user_id={user_id}&first=100"
        if cursor:
            url += f"&after={urllib.parse.quote(cursor)}"
        page = http("GET", url, headers=headers)
        for s in page.get("data", []):
            streams.append(
                {
                    "platform": "twitch",
                    "id": s.get("id", ""),
                    "fav_id": s.get("user_login", ""),
                    "channel": s.get("user_name") or s.get("user_login", ""),
                    "login": s.get("user_login", ""),
                    "title": (s.get("title") or "").strip(),
                    "category": s.get("game_name", ""),
                    "viewers": int(s.get("viewer_count", 0) or 0),
                    "thumbnail": _twitch_thumb(s.get("thumbnail_url", "")),
                    "started_at": s.get("started_at", ""),
                    "url": f"https://twitch.tv/{s.get('user_login', '')}",
                    "live": True,
                }
            )
        cursor = (page.get("pagination") or {}).get("cursor")
        if not cursor:
            break
    return streams


def twitch_search(query: str, live_only: bool) -> list[dict]:
    access, client_id, _ = twitch_access_token()
    headers = {"Authorization": f"Bearer {access}", "Client-Id": client_id}
    url = (
        "https://api.twitch.tv/helix/search/channels?first=20&query="
        + urllib.parse.quote(query)
    )
    if live_only:
        url += "&live_only=true"
    page = http("GET", url, headers=headers)
    results = []
    for c in page.get("data", []):
        results.append(
            {
                "platform": "twitch",
                "id": c.get("id", ""),
                "fav_id": c.get("broadcaster_login", ""),
                "channel": c.get("display_name") or c.get("broadcaster_login", ""),
                "login": c.get("broadcaster_login", ""),
                "title": (c.get("title") or "").strip(),
                "category": c.get("game_name", ""),
                "viewers": 0,
                "thumbnail": c.get("thumbnail_url", ""),
                "started_at": c.get("started_at", ""),
                "url": f"https://twitch.tv/{c.get('broadcaster_login', '')}",
                "live": bool(c.get("is_live")),
            }
        )
    return results


