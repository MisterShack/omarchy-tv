# CLI
# --------------------------------------------------------------------------- #

def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="tv", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--json", action="store_true", help="machine-readable output")
    sub = p.add_subparsers(dest="cmd", required=True)

    sub.add_parser("setup").set_defaults(func=cmd_setup)

    creds = sub.add_parser("creds")
    creds.add_argument("creds_cmd", choices=["set", "show"])
    creds.add_argument("--twitch-client-id", dest="twitch_client_id")
    creds.add_argument("--youtube-client-id", dest="youtube_client_id")
    creds.add_argument("--youtube-client-secret", dest="youtube_client_secret")
    creds.set_defaults(func=cmd_creds)

    auth = sub.add_parser("auth")
    auth_sub = auth.add_subparsers(dest="auth_cmd", required=True)
    auth_sub.add_parser("twitch").set_defaults(func=cmd_auth_twitch)
    auth_sub.add_parser("youtube").set_defaults(func=cmd_auth_youtube)
    lo = auth_sub.add_parser("logout")
    lo.add_argument("target", choices=["twitch", "youtube", "all"])
    lo.set_defaults(func=cmd_auth_logout)

    conn = sub.add_parser("connect", help="interactive credentials + login walkthrough")
    conn.add_argument("platform", choices=["twitch", "youtube"])
    conn.add_argument("--force", action="store_true", help="re-enter credentials even if set")
    conn.set_defaults(func=cmd_connect)

    isc = sub.add_parser("is-connected")
    isc.add_argument("platform", choices=["twitch", "youtube"])
    isc.set_defaults(func=cmd_is_connected)

    sub.add_parser("status").set_defaults(func=cmd_status)

    live = sub.add_parser("live")
    live.add_argument("--platform", choices=["twitch", "youtube"])
    live.add_argument("--no-cache", action="store_true")
    live.set_defaults(func=cmd_live)

    search = sub.add_parser("search")
    search.add_argument("query", nargs="+")
    search.add_argument("--platform", choices=["twitch", "youtube"])
    search.add_argument("--live-only", action="store_true")
    search.set_defaults(func=cmd_search)

    fav = sub.add_parser("fav")
    fav.add_argument("fav_cmd", choices=["list", "add", "remove", "toggle"])
    fav.add_argument("platform", nargs="?")
    fav.add_argument("id", nargs="?")
    fav.set_defaults(func=cmd_fav)

    watch = sub.add_parser("watch")
    watch.add_argument("target")
    watch.set_defaults(func=cmd_watch)

    chat = sub.add_parser("chat", help="toggle a chat window docked next to mpv")
    chat.add_argument("target", nargs="?", help="stream URL or twitch login")
    chat.add_argument("--toggle", action="store_true",
                      help="open if closed, close if open")
    chat.add_argument("--close", action="store_true")
    chat.add_argument("--width", type=int, default=0,
                      help=f"chat width in px (default {CHAT_WIDTH})")
    chat.set_defaults(func=cmd_chat)

    opn = sub.add_parser("open")
    opn.add_argument("target")
    opn.set_defaults(func=cmd_open)

    return p


def main(argv=None) -> int:
    args = build_parser().parse_args(argv)
    try:
        return args.func(args)
    except TvError as exc:
        if args.json:
            print(json.dumps({"error": str(exc)}))
        else:
            print(f"tv: {exc}", file=sys.stderr)
        return 2
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
