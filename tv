def get_favs() -> dict:
    data = load_json(FAV_FILE, {})
    data.setdefault("twitch", [])
    data.setdefault("youtube", [])
    return data


def is_fav(favs: dict, platform: str, fav_id: str) -> bool:
    return fav_id.lower() in {x.lower() for x in favs.get(platform, [])}


def cmd_fav(args) -> int:
    favs = get_favs()
    action = args.fav_cmd

    if action == "list":
        out(favs, args.json)
        return 0

    platform, fav_id = args.platform, args.id
    if platform not in ("twitch", "youtube") or not fav_id:
        raise TvError("usage: tv fav <add|remove|toggle> <twitch|youtube> <id>")

    current = favs[platform]
    exists = is_fav(favs, platform, fav_id)
    if action == "add" or (action == "toggle" and not exists):
        if not exists:
            current.append(fav_id)
        state = "added"
    elif action in ("remove", "toggle"):
        favs[platform] = [x for x in current if x.lower() != fav_id.lower()]
        state = "removed"
    else:
        raise TvError(f"unknown fav action: {action}")

    save_json(FAV_FILE, favs)
    out({"ok": True, "state": state, "platform": platform, "id": fav_id}, args.json)
    return 0


