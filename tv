def _print_human(obj) -> None:
    if isinstance(obj, dict) and "streams" in obj:
        streams = obj["streams"]
        if not streams:
            print("Nothing live right now.")
        for s in streams:
            star = "★ " if s.get("favorite") else "  "
            viewers = f"{s['viewers']:>7,}" if s.get("viewers") else "      ·"
            tag = s["platform"][0].upper()
            cat = f"  ({s['category']})" if s.get("category") else ""
            print(f"{star}[{tag}] {viewers}  {s['channel']}{cat}")
            if s.get("title"):
                print(f"          {s['title'][:90]}")
        for err in obj.get("errors", []):
            print(f"! {err}", file=sys.stderr)
        return
    print(json.dumps(obj, indent=2))


