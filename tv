# --------------------------------------------------------------------------- #
# OAuth — Twitch device code flow
# --------------------------------------------------------------------------- #

def _open_browser(url: str) -> None:
    try:
        subprocess.Popen(
            ["xdg-open", url],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except OSError:
        pass


def twitch_device_login() -> dict:
    client_id = require_cred("twitch_client_id")
    start = http(
        "POST",
        "https://id.twitch.tv/oauth2/device",
        form={"client_id": client_id, "scopes": TWITCH_SCOPES},
    )
    device_code = start["device_code"]
    interval = int(start.get("interval", 5)) or 5
    expires = now() + int(start.get("expires_in", 1800))
    verify = start.get("verification_uri") or start.get("verification_uri_complete")

    print(f"\n  Open:  {verify}")
    print(f"  Code:  {start['user_code']}\n")
    _open_browser(start.get("verification_uri_complete") or verify)

    while now() < expires:
        time.sleep(interval)
        try:
            token = http(
                "POST",
                "https://id.twitch.tv/oauth2/token",
                form={
                    "client_id": client_id,
                    "scopes": TWITCH_SCOPES,
                    "device_code": device_code,
                    "grant_type": "urn:ietf:params:oauth:grant-type:device_code",
                },
            )
        except TvError as exc:
            if "authorization_pending" in str(exc):
                continue
            if "slow_down" in str(exc):
                interval += 2
                continue
            raise
        return token
    raise TvError("device code expired before authorization")


def cmd_auth_twitch(args) -> int:
    token = twitch_device_login()
    access = token["access_token"]
    record = {
        "access_token": access,
        "refresh_token": token.get("refresh_token", ""),
        "expires_at": now() + int(token.get("expires_in", 14400)),
        "scope": token.get("scope", TWITCH_SCOPES),
    }
    me = http(
        "GET",
        "https://api.twitch.tv/helix/users",
        headers={
            "Authorization": f"Bearer {access}",
            "Client-Id": require_cred("twitch_client_id"),
        },
    )
    user = (me.get("data") or [{}])[0]
    record["user_id"] = user.get("id", "")
    record["login"] = user.get("login", "")
    save_json(TWITCH_TOKEN, record)
    out({"ok": True, "platform": "twitch", "login": record["login"]}, args.json)
    return 0


def twitch_access_token() -> tuple[str, str, str]:
    """Return (access_token, client_id, user_id), refreshing if near expiry."""
    rec = load_json(TWITCH_TOKEN, None)
    if not rec:
        raise TvError("not logged in to Twitch (run `tv auth twitch`)")
    client_id = require_cred("twitch_client_id")

    if rec.get("expires_at", 0) - now() < 300 and rec.get("refresh_token"):
        try:
            refreshed = http(
                "POST",
                "https://id.twitch.tv/oauth2/token",
                form={
                    "client_id": client_id,
                    "grant_type": "refresh_token",
                    "refresh_token": rec["refresh_token"],
                },
            )
            rec["access_token"] = refreshed["access_token"]
            rec["refresh_token"] = refreshed.get("refresh_token", rec["refresh_token"])
            rec["expires_at"] = now() + int(refreshed.get("expires_in", 14400))
            save_json(TWITCH_TOKEN, rec)
        except TvError:
            pass  # try the existing token; the API call will surface a 401

    return rec["access_token"], client_id, rec.get("user_id", "")


# --------------------------------------------------------------------------- #
# OAuth — Google (YouTube) device code flow
# --------------------------------------------------------------------------- #

def youtube_device_login() -> dict:
    client_id = require_cred("youtube_client_id")
    client_secret = require_cred("youtube_client_secret")
    start = http(
        "POST",
        "https://oauth2.googleapis.com/device/code",
        form={"client_id": client_id, "scope": YOUTUBE_SCOPE},
    )
    device_code = start["device_code"]
    interval = int(start.get("interval", 5)) or 5
    expires = now() + int(start.get("expires_in", 1800))
    verify = start.get("verification_url") or start.get("verification_uri")

    print(f"\n  Open:  {verify}")
    print(f"  Code:  {start['user_code']}\n")
    _open_browser(verify)

    while now() < expires:
        time.sleep(interval)
        try:
            token = http(
                "POST",
                "https://oauth2.googleapis.com/token",
                form={
                    "client_id": client_id,
                    "client_secret": client_secret,
                    "device_code": device_code,
                    "grant_type": "urn:ietf:params:oauth:grant-type:device_code",
                },
            )
        except TvError as exc:
            if "authorization_pending" in str(exc):
                continue
            if "slow_down" in str(exc):
                interval += 2
                continue
            raise
        return token
    raise TvError("device code expired before authorization")


def cmd_auth_youtube(args) -> int:
    token = youtube_device_login()
    record = {
        "access_token": token["access_token"],
        "refresh_token": token.get("refresh_token", ""),
        "expires_at": now() + int(token.get("expires_in", 3600)),
    }
    save_json(YOUTUBE_TOKEN, record)
    # Force a fresh subscription pull on the next `live`.
    try:
        os.remove(SUBS_CACHE)
    except OSError:
        pass
    out({"ok": True, "platform": "youtube"}, args.json)
    return 0


def youtube_access_token() -> str:
    rec = load_json(YOUTUBE_TOKEN, None)
    if not rec:
        raise TvError("not logged in to YouTube (run `tv auth youtube`)")
    if rec.get("expires_at", 0) - now() < 120:
        if not rec.get("refresh_token"):
            raise TvError("YouTube token expired and no refresh token; re-run `tv auth youtube`")
        refreshed = http(
            "POST",
            "https://oauth2.googleapis.com/token",
            form={
                "client_id": require_cred("youtube_client_id"),
                "client_secret": require_cred("youtube_client_secret"),
                "refresh_token": rec["refresh_token"],
                "grant_type": "refresh_token",
            },
        )
        rec["access_token"] = refreshed["access_token"]
        rec["expires_at"] = now() + int(refreshed.get("expires_in", 3600))
        save_json(YOUTUBE_TOKEN, rec)
    return rec["access_token"]


