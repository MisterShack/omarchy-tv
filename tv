def auth_state() -> dict:
    return {
        "twitch": bool(load_json(TWITCH_TOKEN, None)),
        "youtube": bool(load_json(YOUTUBE_TOKEN, None)),
    }


def creds_state() -> dict:
    creds = get_creds()
    return {
        "twitch": bool(creds.get("twitch_client_id")),
        "youtube": bool(
            creds.get("youtube_client_id") and creds.get("youtube_client_secret")
        ),
    }


def cmd_status(args) -> int:
    have_player = bool(_which("mpv"))
    payload = {
        "auth": auth_state(),
        "credentials": creds_state(),
        "player": "mpv" if have_player else "browser",
        "favorites": {k: len(v) for k, v in get_favs().items() if k != "note"},
    }
    out(payload, args.json)
    return 0


def _sort_key(favs):
    """Live before offline, then favorites, then by viewer count."""
    def key(s):
        return (
            0 if s.get("live") else 1,
            0 if is_fav(favs, s["platform"], s.get("fav_id", "")) else 1,
            -int(s.get("viewers", 0) or 0),
            s.get("channel", "").lower(),
        )

    return key


def cmd_live(args) -> int:
    if not args.no_cache:
        cache = load_json(LIVE_CACHE, None)
        if (
            cache
            and cache.get("platform") == (args.platform or "all")
            and now() - cache.get("fetched_at", 0) < LIVE_CACHE_TTL
        ):
            out(cache["payload"], args.json)
            return 0

    favs = get_favs()
    auth = auth_state()
    streams: list[dict] = []
    errors: list[str] = []

    want = args.platform
    if auth["twitch"] and want in (None, "twitch"):
        try:
            streams += twitch_live()
        except TvError as exc:
            errors.append(f"twitch: {exc}")
    if auth["youtube"] and want in (None, "youtube"):
        try:
            streams += youtube_live()
        except TvError as exc:
            errors.append(f"youtube: {exc}")

    for s in streams:
        s["favorite"] = is_fav(favs, s["platform"], s.get("fav_id", ""))
    streams.sort(key=_sort_key(favs))

    payload = {"auth": auth, "credentials": creds_state(), "streams": streams,
               "errors": errors, "fetched_at": now()}
    save_json(LIVE_CACHE, {"platform": want or "all", "fetched_at": now(),
                           "payload": payload})
    out(payload, args.json)
    return 1 if errors and not streams else 0


def cmd_search(args) -> int:
    query = " ".join(args.query).strip()
    if not query:
        raise TvError("usage: tv search <query>")
    favs = get_favs()
    auth = auth_state()
    results: list[dict] = []
    errors: list[str] = []
    want = args.platform

    if auth["twitch"] and want in (None, "twitch"):
        try:
            results += twitch_search(query, args.live_only)
        except TvError as exc:
            errors.append(f"twitch: {exc}")
    if auth["youtube"] and want in (None, "youtube"):
        try:
            results += youtube_search(query)
        except TvError as exc:
            errors.append(f"youtube: {exc}")

    if args.live_only:
        results = [r for r in results if r.get("live")]
    for r in results:
        r["favorite"] = is_fav(favs, r["platform"], r.get("fav_id", ""))
    results.sort(key=_sort_key(favs))

    out({"auth": auth, "query": query, "streams": results, "errors": errors}, args.json)
    return 0


